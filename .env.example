# ==============================================================================
# ERP LEVE DE OBRAS - DOCKER / PRODUÇÃO (.ENV NA RAIZ DO PROJETO)
# ==============================================================================

# Banco de Dados PostgreSQL
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=gere_uma_senha_forte_aqui
POSTGRES_DB=erp_obras

# Segurança JWT (Assinatura de tokens de sessão)
JWT_SECRET=gere_uma_chave_secreta_jwt_forte

# Ambiente do Servidor
NODE_ENV=production
CORS_ORIGIN=*

# Cloudflare R2 / AWS S3 (Armazenamento de Fotos e Comprovantes)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Gateway Asaas (Assinaturas SaaS)
ASAAS_API_KEY=
ASAAS_ENV=sandbox
ASAAS_WEBHOOK_SECRET=
