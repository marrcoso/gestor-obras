# ==============================================================================
# ERP LEVE DE OBRAS - CONFIGURAÇÃO DE AMBIENTE (DESENVOLVIMENTO / LOCAL)
# ==============================================================================

# Servidor HTTP
PORT=3001
NODE_ENV=development

# Segurança JWT
JWT_SECRET=super-secret-key-erp-obras-2026-change-in-production

# CORS (Domínios autorizados separados por vírgula ou * em dev)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Armazenamento de Arquivos
UPLOAD_DIR=uploads

# Cloudflare R2 / AWS S3 (Opcional no desenvolvimento local - usa fallback para /uploads se vazio)
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_BUCKET_NAME=erp-obras-media
# R2_PUBLIC_URL=https://media.gestorobras.com.br

# Gateway de Pagamentos Asaas (Opcional no dev - usa Mock Sandbox se vazio)
ASAAS_API_KEY=your_asaas_api_key_here
ASAAS_ENV=sandbox
ASAAS_WEBHOOK_SECRET=your_webhook_token_secret_here

# Banco de Dados PostgreSQL (Opcional - usa fallback JSON local se vazio)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gestor_obras
