# ==============================================================================
# ERP LEVE DE OBRAS - CONFIGURAÇÃO DE AMBIENTE (PRODUÇÃO)
# ==============================================================================

# Servidor HTTP
PORT=3001
NODE_ENV=production

# Segurança JWT (Gere uma chave criptograficamente segura)
JWT_SECRET=generate_strong_random_secret_string_minimum_32_characters

# CORS (Domínio oficial do frontend em produção)
CORS_ORIGIN=https://app.gestorobras.com.br,https://gestorobras.com.br

# Armazenamento em Nuvem - Cloudflare R2
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=erp-obras-production
R2_PUBLIC_URL=https://media.gestorobras.com.br

# Gateway de Pagamentos Asaas (Produção)
ASAAS_API_KEY=$aact_production_api_key_here
ASAAS_ENV=production
ASAAS_WEBHOOK_SECRET=your_configured_webhook_secret_token

# Banco de Dados PostgreSQL Gerenciado (Neon / Supabase / Render)
DATABASE_URL=postgresql://user:password@ep-cool-db.us-east-1.aws.neon.tech/neondb?sslmode=require
